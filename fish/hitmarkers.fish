# Programs which should not play a sound cue on exit
set -g __thm_postexec_blacklist \
    nano \
    vi \
    vim \
    nvim \
    emacsclient \
    man \
    info \
    perldoc \
    pydoc \
    ri \
    help

# Sound files embedded with metaprogramming.
#placeholder<sounds> BEGIN
set -g __thm_hit_sound   ''
set -g __thm_error_sound ''
#placeholder<sounds> END

set -g __thm_cache_dir '/dev/shm'

function play_sound_cue
    paplay --volume=32768 $argv[1] 2> /dev/null & disown
end

function postexec_sound --on-event fish_postexec
    set saved_status $status
    echo $argv | read --local --array last_cmd

    if test $saved_status -ne 0
        play_sound_cue "$__thm_cache_dir/term-hitmarker-error"
        return
    end

    for cmd in $__thm_postexec_blacklist
        if test "$last_cmd[1]" = "$cmd"
            return
        end
    end

    play_sound_cue "$__thm_cache_dir/term-hitmarker-hit"
end

function _init_hitmarkers
    if test ! -e "$__thm_cache_dir/term-hitmarker-hit"
        printf '%s' $__thm_hit_sound | base64 -d > "$__thm_cache_dir/term-hitmarker-hit"
    end
    if test ! -e "$__thm_cache_dir/term-hitmarker-error"
        printf '%s' $__thm_error_sound | base64 -d > "$__thm_cache_dir/term-hitmarker-error"
    end
end
_init_hitmarkers
